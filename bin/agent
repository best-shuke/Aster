#!/bin/sh

script_path=$0
while [ -L "$script_path" ]; do
    script_dir=$(CDPATH= cd -P "$(dirname "$script_path")" && pwd) || exit 1
    script_path=$(readlink "$script_path") || exit 1
    case "$script_path" in
        /*) ;;
        *) script_path="$script_dir/$script_path" ;;
    esac
done

program_dir=$(CDPATH= cd -P "$(dirname "$script_path")/.." && pwd) || exit 1
export DEEPSEEK_ENV_FILE="$program_dir/.env"

exec "$program_dir/.venv/bin/python" "$program_dir/main.py" "$@"
